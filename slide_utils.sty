% ======================================================================
% SLIDE_UTILS.STY - Utility package for accessible_slides.tex
% ======================================================================
% Purpose: Section-separator slides plus optional PDF bookmarks for
% accessible LaTeX slide decks. Not required for accessibility.
%
% Usage: \usepackage{slide_utils}
%
% For multi-page bibliography splitting, see slide_bib.sty (separate file).
%
% Author: Richard Stanton
% License: Same as accessible_slides.tex

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{slide_utils}[2026/05/15 v2.2 Section separators + bookmarks for accessible slides]

% ----------------------------------------------------------------------
% Dependency guards
% ----------------------------------------------------------------------
% Section 2 wraps \section to emit \pdfbookmark, and uses the bookmark
% package's \pdfbookmark. Section 1 uses the AccessibleRed color. We
% don't \RequirePackage hyperref/bookmark ourselves (loading order with
% the host document matters), but we do raise clear errors if a caller
% forgets, and we provide a fallback color so the separator slides
% don't fail with an undefined-color error.

\RequirePackage{xparse}

\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{}{%
    \PackageError{slide_utils}{%
      slide_utils requires hyperref to be loaded\MessageBreak
      before \string\usepackage{slide_utils}}{%
      Add \string\usepackage{hyperref} (and \string\usepackage{bookmark})%
      \MessageBreak before \string\usepackage{slide_utils}.}%
  }%
  \@ifpackageloaded{bookmark}{}{%
    \PackageError{slide_utils}{%
      slide_utils requires the bookmark package\MessageBreak
      to be loaded before \string\usepackage{slide_utils}}{%
      Add \string\usepackage{bookmark} after \string\usepackage{hyperref}.}%
  }%
}

% Fallback color. Defined with \providecolor so the host document can
% override (and the templates do).
\RequirePackage{xcolor}
\providecolor{AccessibleRed}{rgb}{0.6,0,0}

% ======================================================================
% SECTION 1: SECTION SLIDE SUPPORT
% ======================================================================
% Commands for creating dedicated section title slides
%
% IMPORTANT: This redefinition happens at \begin{document} to ensure
% it captures any earlier redefinitions (e.g., bookmark handling)

% Storage for section titles
\gdef\g@slideutils@sectitle{}
\gdef\g@slideutils@subsectitle{}

% Delay the redefinition until document begins
\AtBeginDocument{%
  % Save whatever \section is at this point (includes all preamble modifications)
  \NewCommandCopy{\slideutils@origsection}{\section}
  \NewCommandCopy{\slideutils@origsubsection}{\subsection}
  
  % Redefine \section to capture title and add separator frame
  \RenewDocumentCommand{\section}{s o m}{%
    % Store the title (prefer optional arg if given, otherwise mandatory)
    \IfNoValueTF{#2}%
      {\xdef\g@slideutils@sectitle{#3}}%
      {\xdef\g@slideutils@sectitle{#2}}%
    % Call the original (possibly bookmark-enhanced) \section
    \IfBooleanTF{#1}%
      {\IfNoValueTF{#2}{\slideutils@origsection*{#3}}{\slideutils@origsection*[#2]{#3}}}%
      {\IfNoValueTF{#2}{\slideutils@origsection{#3}}{\slideutils@origsection[#2]{#3}}}%
    % Add separator frame
    \begin{frame}{}%
      \centering
      \vfill
      \vspace*{-.3in}%
      {\color{AccessibleRed}\LARGE\bfseries\thesection.\ \g@slideutils@sectitle\par}%
      \vfill
    \end{frame}%
  }
  
  % Same for subsections
  \RenewDocumentCommand{\subsection}{s o m}{%
    \IfNoValueTF{#2}%
      {\xdef\g@slideutils@subsectitle{#3}}%
      {\xdef\g@slideutils@subsectitle{#2}}%
    \IfBooleanTF{#1}%
      {\IfNoValueTF{#2}{\slideutils@origsubsection*{#3}}{\slideutils@origsubsection*[#2]{#3}}}%
      {\IfNoValueTF{#2}{\slideutils@origsubsection{#3}}{\slideutils@origsubsection[#2]{#3}}}%
    \begin{frame}{}%
      \centering
      \vfill
      \vspace*{-.3in}%
      {\color{blue}\Large\g@slideutils@subsectitle\par}%
      \vfill
    \end{frame}%
  }
}

% ======================================================================
% SECTION 2: OPTIONAL PDF BOOKMARKS
% ======================================================================
% NOT required for accessibility (PDF tagging handles screen readers).
% Adds a left-pane navigation outline: \section titles at level 1,
% frame titles at level 2 beneath them.
%
% REQUIREMENTS:
%   - hyperref and bookmark packages loaded BEFORE this package
%     (so \Hy@writebookmark and \pdfbookmark exist).
%
% INTERACTION WITH SECTION 1:
%   The bookmark code wraps \section at preamble time. Section 1's
%   \AtBeginDocument hook captures that wrapped \section, so separator
%   slides and bookmarks compose correctly.

\makeatletter
\DeclareCommandCopy{\OriginalSectionForBookmarks}{\section}

\RenewDocumentCommand{\section}{s o m}{%
  \begingroup
    \def\Hy@writebookmark##1##2##3##4##5{}%
    \IfBooleanTF{#1}
      {\phantomsection\IfNoValueTF{#2}{\OriginalSectionForBookmarks*{#3}}{\OriginalSectionForBookmarks*[#2]{#3}}}%
      {\IfNoValueTF{#2}{\OriginalSectionForBookmarks{#3}}{\OriginalSectionForBookmarks[#2]{#3}}}%
  \endgroup
  \IfBooleanTF{#1}
    {\IfNoValueTF{#2}{\pdfbookmark[1]{#3}{section-star.\thepage.\number\inputlineno}}{\pdfbookmark[1]{#2}{section-star.\thepage.\number\inputlineno}}}%
    {\IfNoValueTF{#2}{\pdfbookmark[1]{Section \thesection: #3}{section.\thesection}}{\pdfbookmark[1]{Section \thesection: #2}{section.\thesection}}}%
}
\makeatother

\ExplSyntaxOn
\int_new:N \g_slideutils_frame_bookmark_int

\AddToHook{cmd/frametitle/after}{%
  \tl_if_empty:NF \g__talk_frame_title_tl
    {
      \int_gincr:N \g_slideutils_frame_bookmark_int
      \pdfbookmark[2]{\tl_use:N \g__talk_frame_title_tl}
        {frame.\int_use:N \g_slideutils_frame_bookmark_int}
    }
}
\ExplSyntaxOff


\endinput
